{
  "name": "@dosu/decant",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first analytics for Claude Code and Codex sessions, built by Dosu.",
  "license": "Apache-2.0",
  "repository": "https://github.com/dosu-ai/decant",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "bin": {
    "decant": "./src/cli.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "overrides": {
    "fast-uri": "^3.1.5"
  },
  "scripts": {
    "predev": "bun install --frozen-lockfile",
    "dev": "bun run src/cli.ts serve",
    "start": "bun run src/cli.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run test && bun run typecheck && bun run lint && bun run distcheck",
    "distcheck": "bun run scripts/dist-check.ts",
    "build:binary": "bun run scripts/build-binaries.ts",
    "build:npm": "bun run scripts/build-npm.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@letta-ai/trajectory": "^0.3.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ajv": "^8.20.0",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@logtape/logtape": "^2.2.4",
    "@shikijs/langs": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1"
  }
}
