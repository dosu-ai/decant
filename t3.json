{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "bun install --frozen-lockfile",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Check",
      "command": "just ts-check",
      "icon": "test"
    },
    {
      "name": "Fix formatting",
      "command": "just fmt",
      "icon": "lint"
    },
    {
      "name": "Serve UI on a scratch copy",
      "command": "just serve-scratch",
      "icon": "play",
      "stopOnSettle": true
    },
    {
      "name": "Distribution check",
      "command": "just dist-check",
      "icon": "build"
    }
  ]
}
