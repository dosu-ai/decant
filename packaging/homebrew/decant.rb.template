## Template for Formula/decant.rb in the dosu-ai/homebrew-dosu tap.
##
## Rendered and smoke-tested by .github/workflows/release.yml, then pushed by
## tap-update on every stable is_latest release. The placeholder scheme is
## deliberately simple: each placeholder is a unique literal token replaced
## with plain `sed s///g` (values are semver strings and lowercase-hex digests,
## so no sed escaping is ever needed), and `##` doc lines like this one are
## stripped from the rendered formula (`/^##/d`).
## Homebrew infers the formula version from the release URLs; an explicit
## `version` stanza is redundant and fails the tap-wide audit.
##
##   __VERSION__             release version without the leading v (e.g. 0.1.0)
##   __SHA256_DARWIN_ARM64__ sha256 of decant-darwin-arm64.tar.gz (from SHA256SUMS)
##   __SHA256_DARWIN_X64__   sha256 of decant-darwin-x64.tar.gz   (from SHA256SUMS)
##   __SHA256_LINUX_ARM64__  sha256 of decant-linux-arm64.tar.gz  (from SHA256SUMS)
##   __SHA256_LINUX_X64__    sha256 of decant-linux-x64.tar.gz    (from SHA256SUMS)
class Decant < Formula
  desc "Analyze Claude Code and Codex sessions: tokens, context windows, and cost"
  homepage "https://github.com/dosu-ai/decant"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/dosu-ai/decant/releases/download/v__VERSION__/decant-darwin-arm64.tar.gz"
      sha256 "__SHA256_DARWIN_ARM64__"
    end
    on_intel do
      url "https://github.com/dosu-ai/decant/releases/download/v__VERSION__/decant-darwin-x64.tar.gz"
      sha256 "__SHA256_DARWIN_X64__"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/dosu-ai/decant/releases/download/v__VERSION__/decant-linux-arm64.tar.gz"
      sha256 "__SHA256_LINUX_ARM64__"
    end
    on_intel do
      url "https://github.com/dosu-ai/decant/releases/download/v__VERSION__/decant-linux-x64.tar.gz"
      sha256 "__SHA256_LINUX_X64__"
    end
  end

  def install
    bin.install "decant"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/decant --version")
  end
end
