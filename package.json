{
  "name": "@dosu/decant",
  "version": "0.0.0",
  "private": true,
  "description": "Extract Claude Code and Codex CLI sessions into a normalized, full-text-searchable local SQLite archive.",
  "license": "Apache-2.0",
  "repository": "https://github.com/dosu-ai/decant",
  "type": "module",
  "bin": {
    "decant": "./src/cli.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "predev": "bun install --frozen-lockfile",
    "dev": "bun run src/cli.ts serve",
    "start": "bun run src/cli.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run test && bun run typecheck && bun run lint && bun run distcheck",
    "distcheck": "bun run scripts/dist-check.ts",
    "build:binary": "bun run scripts/build-binaries.ts",
    "build:npm": "bun run scripts/build-npm.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@logtape/logtape": "^2.2.4",
    "commander": "^15.0.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
